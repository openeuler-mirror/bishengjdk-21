################################################################################

ifeq ($(HOTSPOT_TARGET_CPU_ARCH), aarch64)
  include $(TOPDIR)/make/ToolsHotspot.gmk

  STRING_CASE_UCD_DIR := $(TOPDIR)/src/java.base/share/data/unicodedata
  STRING_CASE_UNICODE_DATA := $(STRING_CASE_UCD_DIR)/UnicodeData.txt
  STRING_CASE_SPECIAL_CASING := $(STRING_CASE_UCD_DIR)/SpecialCasing.txt
  STRING_CASE_TEMPLATE := $(TOPDIR)/make/data/stringcasemappings/stringCaseMappings_aarch64.hpp.template
  STRING_CASE_HEADER := $(JVM_VARIANT_OUTPUTDIR)/gensrc/stringCaseMappings_aarch64.hpp

  $(eval $(call SetupExecute, generate_string_case_mappings, \
      INFO := Generating AArch64 String case mapping tables, \
      DEPS := $(STRING_CASE_UNICODE_DATA) $(STRING_CASE_SPECIAL_CASING) \
          $(STRING_CASE_TEMPLATE) $(BUILD_TOOLS_HOTSPOT), \
      OUTPUT_FILE := $(STRING_CASE_HEADER), \
      COMMAND := $(TOOL_GENERATESTRINGCASEMAPPINGS) \
          $(STRING_CASE_UNICODE_DATA) $(STRING_CASE_SPECIAL_CASING) \
          $(STRING_CASE_TEMPLATE) $(STRING_CASE_HEADER), \
  ))

  TARGETS += $(generate_string_case_mappings_TARGET)
endif

################################################################################
